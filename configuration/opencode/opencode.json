{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "permissions": [
    {
      "action": "*",
      "effect": "ask",
      "resource": "*"
    },
    {
      "action": "glob",
      "effect": "allow",
      "resource": "*"
    },
    {
      "action": "grep",
      "effect": "allow",
      "resource": "*"
    },
    {
      "action": "question",
      "effect": "allow",
      "resource": "*"
    },
    {
      "action": "read",
      "effect": "allow",
      "resource": "*"
    }
  ],
  "update": "disable"
}
