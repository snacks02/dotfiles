#!/usr/bin/env fish

if not set --query argv[1]
    echo "Usage: $(status basename) <files>"
    exit 1
end

for target in $argv
    if not path is --type file $target
        echo "Warning: `$target` is not a file."
        continue
    end

    set flags --best --threads=(nproc)
    if test (path extension $target) = .flac
        set --append flags --force
    else
        set --append flags --delete-input-file
    end
    flac $target $flags
end
