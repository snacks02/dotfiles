#!/usr/bin/env fish

if not set --query argv[1]
    echo "Usage: $(status basename) <files>"
    exit 1
end

for target in $argv
    if not path is --type file $target
        echo "Warning: `$target` is not a file."
        continue
    end

    wavpack \
        -hh \
        -o (path change-extension .wv $target) \
        -x6 \
        $target \
        && rm $target
end
